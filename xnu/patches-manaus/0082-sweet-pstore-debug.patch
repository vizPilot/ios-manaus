From: vizPilot <vizPilot@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:00:00 -0300
Subject: [PATCH] sweet: write boot stage marker to ramoops pmsg for manaus debug

---
 osfmk/arm64/sweet_early.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,5 +1,11 @@
 	early_stride = (uint32_t)(ba->Video.v_rowBytes / 4);
+	/* PSTORE: write XNU alive marker to ramoops pmsg zone */
+	volatile uint32_t *pmsg = (volatile uint32_t *)0x48160000UL;
+	pmsg[0] = 0x43474244u;
+	pmsg[1] = 0;
+	pmsg[2] = 4;
+	pmsg[3] = 0x584e5521u;
 }
