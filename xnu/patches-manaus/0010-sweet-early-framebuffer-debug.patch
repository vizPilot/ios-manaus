diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index ccbb188..1bd3e3a 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,38 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(SWEET)
+	/*
+	 * Stage 0: white 64x32 band, no stack or page tables needed.
+	 * manaus: LK chooses the splash framebuffer per boot, so take the
+	 * address, row pitch and height from boot_args.Video (x20 = args)
+	 * instead of a compile-time constant. Skip if Video is empty.
+	 */
+	ldr		x0, [x20, BA_VIDEO_BASE]
+	cbz		x0, Lsweet_mark_done
+	ldr		x4, [x20, BA_VIDEO_ROWBYTES]
+	cbz		x4, Lsweet_mark_done
+	ldr		x2, [x20, BA_VIDEO_HEIGHT]
+	cmp		x2, #32
+	b.lo		Lsweet_mark_done
+	sub		x2, x2, #32
+	madd		x0, x2, x4, x0			// x0 += (height - 32) * rowBytes
+	mov		w1, #-1
+	mov		x2, #32
+Lsweet_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsweet_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsweet_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsweet_mark_row
+Lsweet_mark_done:
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +641,26 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(SWEET)
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * L2 table. manaus: LK picks the splash framebuffer per boot, so map
+	 * the 32MB block containing the live base from boot_args.Video.
+	 * Bring-up RAM (5GiB) and the framebuffer (4GiB) are both below 64GB,
+	 * so they share V=P L1 index 0 and the first L2 page is
+	 * bootstrap_pagetables + 2*PGBYTES. Skip if Video is empty.
+	 */
+	ldr		x10, [x20, BA_VIDEO_BASE]
+	cbz		x10, Lsweet_fb_map_done
+	lsr		x12, x10, #(ARM_TT_L2_SHIFT)
+	lsl		x10, x12, #(ARM_TT_L2_SHIFT)		// 32MB-aligned block base
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+Lsweet_fb_map_done:
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
new file mode 100644
index 0000000..24bdb39
--- /dev/null
+++ b/osfmk/arm64/sweet_early.c
@@ -0,0 +1,174 @@
+/*
+ * Motorola Edge 40 Neo (manaus) bootstrap console. No allocation, locks, ADT
+ * parsing or per-CPU state: panic() can reach this before a current thread
+ * exists. start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable
+ * memory. Stop using that mapping before arm_vm_init tears down bootstrap
+ * TTBR0 (patch 0012 installs a kernel VA alias first).
+ *
+ * LK picks the splash framebuffer per boot and the shim forwards the live
+ * values in boot_args.Video, so arm_init() calls sweet_early_init(args)
+ * before the first mark. Without a valid Video the console stays disabled
+ * instead of writing to a stale address.
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(SWEET)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <pexpert/arm64/boot.h>
+
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+
+extern unsigned char iso_font[256 * 16];
+
+static volatile uint32_t *early_fb;
+static uint64_t early_fb_phys;
+static uint32_t early_width, early_height, early_stride;
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static unsigned int
+sweet_early_rows(void)
+{
+	return early_height > 32u ? (early_height - 32u) / EARLY_CELL_H : 0;
+}
+
+static unsigned int
+sweet_early_cols(void)
+{
+	return early_width / EARLY_CELL_W;
+}
+
+void
+sweet_early_init(const void *args)
+{
+	const boot_args *ba = (const boot_args *)args;
+
+	if (ba == NULL || ba->Video.v_baseAddr == 0 || ba->Video.v_rowBytes == 0 ||
+	    ba->Video.v_width == 0 || ba->Video.v_height == 0 ||
+	    ba->Video.v_rowBytes < ba->Video.v_width * 4) {
+		return;
+	}
+	early_fb_phys = ba->Video.v_baseAddr;
+	early_fb = (volatile uint32_t *)(uintptr_t)early_fb_phys;
+	early_width = (uint32_t)ba->Video.v_width;
+	early_height = (uint32_t)ba->Video.v_height;
+	early_stride = (uint32_t)(ba->Video.v_rowBytes / 4);
+}
+
+uint64_t
+sweet_early_fb_phys(void)
+{
+	return early_fb_phys;
+}
+
+static void
+sweet_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = early_fb + (early_row * EARLY_CELL_H + y) * early_stride;
+		for (unsigned int x = 0; x < early_width; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+sweet_early_putc(char c)
+{
+	if (early_disabled || early_fb == NULL) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		sweet_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col >= sweet_early_cols()) {
+		unsigned int rows = sweet_early_rows();
+		early_col = 0;
+		if (rows == 0) {
+			return;
+		}
+		early_row = (early_row + 1) % rows;
+		sweet_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * early_stride +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+sweet_early_string(const char *s)
+{
+	while (*s) {
+		sweet_early_putc(*s++);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || early_fb == NULL || stage > 8 || early_height < 32u) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = early_height - 32; y < early_height; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64 && x < early_width; x++) {
+			early_fb[y * early_stride + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_string("SWEET EARLY ");
+	sweet_early_putc((char)('0' + stage));
+	sweet_early_string(": ");
+	sweet_early_string(label);
+	sweet_early_putc('\n');
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking || early_fb == NULL) {
+		return;
+	}
+	early_panicking = 1;
+	sweet_early_string("\nSWEET EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, sweet_early_putc, 16);
+	va_end(copy);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_disable(void)
+{
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* SWEET */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
new file mode 100644
index 0000000..fa28ace
--- /dev/null
+++ b/osfmk/arm64/sweet_early.h
@@ -0,0 +1,35 @@
+/* Screen diagnostics through bootstrap TTBR0 and the final kernel TTBR1. */
+#ifndef _ARM64_SWEET_EARLY_H_
+#define _ARM64_SWEET_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(SWEET)
+/* Read boot_args.Video; call once from arm_init() before the first mark. */
+void sweet_early_init(const void *args);
+/* Physical splash framebuffer base, 0 if Video was empty (patch 0012). */
+uint64_t sweet_early_fb_phys(void);
+void sweet_early_mark(unsigned int stage, const char *label);
+void sweet_early_putc(char c);
+void sweet_early_panic(const char *fmt, va_list *args);
+void sweet_early_disable(void);
+#else
+static inline void sweet_early_init(const void *args)
+{
+	(void)args;
+}
+static inline uint64_t sweet_early_fb_phys(void)
+{
+	return 0;
+}
+static inline void sweet_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void sweet_early_disable(void) {}
+#endif
+
+#endif
