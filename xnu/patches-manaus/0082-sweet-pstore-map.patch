From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: vizPilot <vizPilot@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:00:00 -0300
Subject: [PATCH] sweet: map pstore (0x48000000) in bootstrap page tables for manaus debug

---
 osfmk/arm64/start.s | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -1,5 +1,13 @@
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	/* Map pstore (0x48000000, 32MB) as Normal-NC for debug. */
+	mov		x10, #0x48000000
+	lsr		x12, x10, #(ARM_TT_L2_SHIFT)
+	lsl		x10, x12, #(ARM_TT_L2_SHIFT)
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 Lsweet_fb_map_done:
